<!doctype html><html><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>body{margin:0}</style></head><body><title>greenola Ähre</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&family=Cormorant+Garamond:ital,wght@1,500&family=Inter:wght@300&display=swap">
<style>
/* greenola · Pergament-Atelier: beige Papier, Oliv-Tinte, Korn-Gold nur fuer Text-Akzente */
:root{
  --canvas:#F4ECDF;     /* Pergament */
  --bone:#EDE3D2;       /* Karten */
  --linen:#E3D6C0;      /* zweiter Knopf, Kacheln */
  --stone:#CFC1A8;      /* Haarlinien */
  --mist:#A39C83;
  --drift:#7F7A62;      /* Nebentext */
  --ash:#716E55;
  --ink:#2D300D;        /* Oliv: Schrift und Hauptknopf */
  --ember:#9A6B2F;      /* Korn-Gold: nur Links und Hervorhebung */
  --amber:#B08A5B;
  --sans:'Inter','CursorGothic',system-ui,'Helvetica Neue',sans-serif;
  --serif:'EB Garamond','Iowan Old Style','Palatino Linotype',Georgia,serif;
  --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --r:4px;
  --bg:var(--canvas); --card:var(--bone); --mute:var(--drift);
  --serif-accent:'Cormorant Garamond','Canela',Georgia,serif;
  --ease:cubic-bezier(.625,.05,0,1);
  --shadow-btn:rgba(45,48,13,.18) 0 4px 20px 0;
  --shadow-glass:rgba(45,48,13,.22) 0 10px 30px 0,rgba(255,255,255,.35) 0 1px 0 0 inset;
  --hair:1px solid color-mix(in oklab,var(--ink) 10%,transparent);
  --shadow:rgba(45,40,20,.14) 0 28px 70px 0,rgba(45,40,20,.1) 0 14px 32px 0,0 0 0 1px color-mix(in oklab,var(--ink) 8%,transparent);
  --t:150ms cubic-bezier(.4,0,.2,1);
  color-scheme:light;
}
*{box-sizing:border-box}
html{background:var(--canvas)}
body{background:var(--canvas) url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22280%22 height=%22280%22 viewBox=%220 0 280 280%22%3E%3Cg stroke=%22%232D300D%22 stroke-opacity=%22.2%22 stroke-width=%221%22 stroke-linecap=%22round%22%3E%3Cpath d=%22M70.3,35.2 q7.9,3.5 4.3,16.7%22 fill=%22none%22/%3E%3Cpath d=%22M34.6,117.1 C25.5,120.2 19.6,116.9 16.6,111.0 C22.6,108.1 29.2,109.1 34.6,117.1Z%22 fill=%22none%22/%3E%3Cpath d=%22M30.6,115.7 Q24.4,114.5 20.2,112.2%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M250.3,219.3 q4.3,7.5 -6.4,16.0%22 fill=%22none%22/%3E%3Cpath d=%22M216.8,61.6 C214.7,70.2 209.3,72.8 203.2,71.6 C203.9,65.4 208.0,61.0 216.8,61.6Z%22 fill=%22none%22/%3E%3Cpath d=%22M213.8,63.8 Q209.8,67.8 205.9,69.6%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M144.5,73.5 C152.8,76.7 155.6,82.5 154.9,88.6 C149.0,87.1 144.5,82.4 144.5,73.5Z%22 fill=%22none%22/%3E%3Cpath d=%22M146.8,76.8 Q150.8,81.4 152.8,85.6%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M62.2,261.0 C58.0,252.7 60.8,247.4 67.0,244.7 C70.7,250.2 70.3,256.3 62.2,261.0Z%22 fill=%22none%22/%3E%3Cpath d=%22M63.3,257.4 Q63.9,251.8 66.0,248.0%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M93.3,166.6 C96.5,175.2 92.8,179.4 86.3,180.4 C83.3,174.5 84.6,169.1 93.3,166.6Z%22 fill=%22none%22/%3E%3Cpath d=%22M91.8,169.7 Q90.3,174.7 87.7,177.6%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M158.0,184.3 C166.6,178.9 173.4,180.9 177.8,186.4 C172.4,190.8 165.3,191.3 158.0,184.3Z%22 fill=%22none%22/%3E%3Cpath d=%22M162.4,184.7 Q169.0,184.5 173.9,186.0%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M242.9,165.2 C241.7,156.0 246.2,152.6 253.0,153.0 C254.7,159.5 252.2,164.7 242.9,165.2Z%22 fill=%22none%22/%3E%3Cpath d=%22M245.1,162.5 Q247.7,157.8 251.0,155.4%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M267.1,52.9 C276.2,54.7 277.9,60.1 275.5,66.4 C268.8,65.8 264.7,61.8 267.1,52.9Z%22 fill=%22none%22/%3E%3Cpath d=%22M268.9,55.9 Q272.6,59.8 273.8,63.7%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M19.3,192.1 q-5.6,-4.8 0.5,-14.6%22 fill=%22none%22/%3E%3Cpath d=%22M194.0,260.3 C201.2,254.9 206.7,256.9 210.0,262.5 C205.3,267.0 199.6,267.5 194.0,260.3Z%22 fill=%22none%22/%3E%3Cpath d=%22M197.5,260.8 Q202.9,260.6 206.8,262.0%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3Cpath d=%22M126.2,228.0 C129.0,236.5 125.3,240.3 118.9,240.9 C116.1,235.1 117.6,229.9 126.2,228.0Z%22 fill=%22none%22/%3E%3Cpath d=%22M124.6,230.9 Q123.1,235.6 120.4,238.3%22 fill=%22none%22 stroke-width=%220.70%22/%3E%3C/g%3E%3C/svg%3E") 0 0/280px 280px repeat;color:var(--ink);font:400 16px/1.5 var(--sans);font-feature-settings:"tnum";-webkit-font-smoothing:antialiased;overflow-x:hidden;overflow-x:clip}
h1,h2,h3,p{margin:0;font-weight:400}
a{color:inherit}
img{display:block;max-width:100%}
::selection{background:#8BC4F8;color:var(--ink)}
:focus-visible{outline:1px solid var(--ink);outline-offset:2px}
.wrap{max-width:1300px;margin-inline:auto;padding-inline:24px}
.mono{font:400 12px/1.6 var(--mono);color:var(--ash)}
.eyebrow{font:400 12px/1.63 var(--mono);color:var(--ash)}
.display{font-size:clamp(44px,6.4vw,72px);line-height:1.1;letter-spacing:-.03em}
.h-lg{font-size:clamp(28px,3.2vw,36px);line-height:1.2;letter-spacing:-.02em}
.h{font-size:26px;line-height:1.25;letter-spacing:-.012em}
.h-sm{font-size:22px;line-height:1.3;letter-spacing:-.005em}
.prose{font:400 19px/1.5 var(--serif);color:var(--ash);max-width:34em}
.prose em{color:var(--ink)}
.link{color:var(--ember);text-decoration:none}
.link:hover{text-decoration:underline;text-underline-offset:3px}

/* Knoepfe: ein dunkler, ein heller */
.btn{display:inline-flex;align-items:center;gap:8px;border:0;border-radius:var(--r);padding:.78em 1.35em .8em;font:400 14px/1.2 var(--sans);text-decoration:none;cursor:pointer;transition:background-color var(--t),color var(--t)}
.btn.dark{background:var(--ink);color:var(--canvas)}
.btn.dark:hover{background:#40441A}
.btn.light{background:var(--linen);color:var(--ink)}
.btn.light:hover{background:var(--stone)}
.ghost{font-size:14px;color:color-mix(in oklab,var(--ink) 60%,transparent);text-decoration:none;transition:color var(--t)}
.ghost:hover{color:var(--ink);text-decoration:underline;text-underline-offset:3px}

/* Einstieg im Sequel-Aufbau */
.hero h1{font-weight:300;text-wrap:balance}
.s{font-family:var(--serif-accent);font-style:italic;font-weight:500;letter-spacing:-.02em}
.hero .display{font-size:clamp(48px,9.4vw,128px);line-height:1;letter-spacing:-.05em}
.lg{font-size:20px;line-height:1.5}
.top .wrap,.hero .wrap{max-width:1200px;padding-inline:clamp(16px,4vw,40px)}
/* Knoepfe und Etiketten */
.pill{display:inline-flex;align-items:center;gap:10px;height:44px;padding:0 24px;border:0;border-radius:9999px;background:var(--ink);color:var(--bg);font:500 16px/1 var(--sans);text-decoration:none;cursor:pointer;box-shadow:var(--shadow-btn);transition:transform .3s var(--ease),opacity .3s var(--ease)}
.pill:hover{transform:translateY(-1px);opacity:.92}
.ghost{display:inline-flex;align-items:center;gap:10px;height:44px;padding:0 20px;border:1px solid var(--ink);border-radius:9999px;background:transparent;color:var(--ink);font:500 16px/1 var(--sans);text-decoration:none;transition:background-color .3s var(--ease),color .3s var(--ease)}
.ghost:hover{background:var(--ink);color:var(--bg)}
.glass{display:inline-flex;align-items:center;padding:8px 16px;border-radius:9999px;background:rgba(239,228,210,.28);backdrop-filter:blur(20px) saturate(1.4);-webkit-backdrop-filter:blur(20px) saturate(1.4);box-shadow:var(--shadow-glass);color:var(--ink);font-size:11px;line-height:1.5;font-weight:500;letter-spacing:.05em;text-transform:uppercase}
.glass.dark{background:rgba(29,31,8,.28);color:var(--on-photo);box-shadow:rgba(0,0,0,.25) 0 10px 30px 0,rgba(255,255,255,.12) 0 1px 0 0 inset}

/* Kopfzeile */
.top{position:fixed;inset-inline:0;top:0;z-index:40;padding-top:env(safe-area-inset-top,0px);transition:background-color .4s var(--ease)}
.top.solid{background:var(--bg)}
.top-in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;height:84px}
.top .logo{height:52px;justify-self:start}
.top .logo img{height:100%;width:auto;max-width:none}
.top nav{display:flex;gap:28px}
.top nav a{font-size:15px;font-weight:500;text-decoration:none;opacity:.85;transition:opacity .3s var(--ease)}
.top nav a:hover{opacity:1}
.top .pill{justify-self:end}
@media (max-width:760px){.top nav{display:none}.top-in{grid-template-columns:1fr auto;height:72px}.top .logo{height:44px}}

/* 1 · Einstieg: das Bild ist die Buehne */
.hero{position:relative;height:230vh}
.stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;display:flex;align-items:center}
.hero-grid{width:100%;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);align-items:center;gap:clamp(32px,6vw,96px);padding-top:72px}
.hero .display{font-size:clamp(48px,7.6vw,118px)}
.hero-text{display:grid;gap:22px}
.swap{display:grid}
.swap>.hl{grid-area:1/1;align-self:end}
.hl{display:block;overflow:hidden;padding:.08em .06em .1em;margin:-.08em -.06em -.1em}
.hl>span{display:block;will-change:transform,opacity}
/* Motiv: Koerner, die von der Granola-Schale zur Gerstengarbe werden */
.motif{position:relative;justify-self:center;margin:0;width:min(64vh,580px);width:min(64svh,580px);aspect-ratio:1;max-width:100%}
.motif canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
@media (max-width:860px){
  .stage{align-items:flex-start}
  .hero-grid{grid-template-columns:1fr;gap:34px;padding-top:calc(96px + env(safe-area-inset-top,0px))}
  .motif{order:-1;width:min(86vw,44svh)}
  .hero .display{font-size:clamp(40px,11vw,64px)}
  .hero-text{gap:14px}
}
@media (max-width:860px) and (max-height:700px){.motif{width:min(80vw,36svh)}}
.hero-text p{max-width:30em}
@media (max-width:760px){.hero-text p{font-size:16px}}
.hero-sub{opacity:0;transform:translateY(12px)}
.cue{position:absolute;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--ink);text-decoration:none;font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;z-index:2}
.cue i{display:block;width:1px;height:34px;background:currentColor;transform-origin:top;animation:cueLine 1.8s cubic-bezier(.2,.7,.2,1) infinite}
@keyframes cueLine{0%{transform:scaleY(0)}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
@media (prefers-reduced-motion: reduce){.cue i{animation:none}}

/* Zutaten-Leiste */
.strip{padding-block:clamp(48px,6vw,64px);display:grid;gap:16px}
.chips{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.chip{background:var(--linen);border-radius:var(--r);padding:16px;display:grid;gap:4px;align-content:start}
.chip b{font-weight:400;font-size:16px;color:color-mix(in oklab,var(--ink) 80%,transparent)}
@media (max-width:760px){.chips{grid-template-columns:repeat(2,1fr)}.chip:last-child{grid-column:1/-1}}

/* Abschnitte 50/50 */
.feature{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,64px);align-items:center;padding-block:clamp(64px,8vw,96px)}
.feature.rev .copy{order:2}
.copy{display:grid;gap:16px;align-content:start}
.copy .link{font-size:14px;margin-top:4px}
.card{background:var(--bone);border-radius:var(--r);box-shadow:var(--shadow);padding:24px}
.pile{aspect-ratio:1/1;max-width:100%;display:grid;place-items:center}
.pile img{width:84%;height:84%;object-fit:contain}
.big{font-size:clamp(56px,7vw,72px);line-height:1.1;letter-spacing:-.03em}
.steps{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.step{display:grid;gap:8px}
.step .ph{aspect-ratio:4/3;max-width:100%;border-radius:var(--r);overflow:hidden;background:var(--linen)}
.step .ph img{width:100%;height:100%;object-fit:cover;filter:saturate(.85)}
.step p{display:flex;justify-content:space-between;gap:8px}
@media (max-width:860px){.feature{grid-template-columns:1fr}.feature.rev .copy{order:0}}

/* Team */
.team{padding-block:clamp(64px,8vw,96px);display:grid;gap:40px}
.team-head{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,64px);align-items:end}
@media (max-width:860px){.team-head{grid-template-columns:1fr}}
.people{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.person{background:var(--bone);border-radius:var(--r);border:var(--hair);padding:24px;display:grid;gap:16px;transition:background-color var(--t)}
.person:hover{background:var(--linen)}
.person .ini{aspect-ratio:3/2;max-width:100%;border-radius:var(--r);background:var(--canvas);border:var(--hair);display:grid;place-items:center;position:relative}
.person .ini b{font-weight:400;font-size:36px;letter-spacing:-.02em}
.person .ini .mono{position:absolute;left:10px;top:8px}
.person h3{font-size:16px;font-weight:500;line-height:1.3}
.person .desc{font:400 17px/1.35 var(--serif);color:var(--drift)}
@media (max-width:860px){.people{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.people{grid-template-columns:1fr}}

/* Vorbestellen */
.preorder{padding-block:clamp(64px,8vw,96px)}
.yes{padding-block:clamp(48px,6vw,80px) clamp(64px,8vw,96px);border-top:1px solid var(--stone)}
.yes-card{display:grid;gap:16px;max-width:860px;border-left:2px solid var(--ink);padding:8px 0 8px clamp(20px,3vw,32px)}
.yes-card .link{font-size:14px}
.pre{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,64px);align-items:end}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.mail{display:flex;gap:8px}
.mail input{flex:1;min-width:0;border:var(--hair);border-radius:var(--r);background:var(--bone);padding:12px 14px;font:400 16px/1.2 var(--sans);color:var(--ink);outline:none;transition:border-color var(--t)}
.mail input::placeholder{color:var(--mist)}
.mail input:focus{border-color:var(--ink)}
.mail .btn{font-size:15px}
@media (max-width:420px){.mail{flex-direction:column}.mail .btn{justify-content:center}}
.pre-form{display:grid;gap:10px}
.pre-msg{font:400 12px/1.6 var(--mono);color:var(--ash);min-height:1.6em}
.pre-msg.ok{color:var(--ink)}
.pre-msg.err{color:#8A3B12}
@media (max-width:860px){.pre{grid-template-columns:1fr}}
@media (max-width:420px){.term{flex-wrap:wrap}.term .btn{width:100%;justify-content:center}}


/* Idee + Pfeile */
.explain{padding-block:clamp(64px,8vw,96px);display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(32px,4vw,48px);overflow:hidden}
.explain-head{display:grid;gap:16px;max-width:880px}
.display-sm{font-size:clamp(34px,4.6vw,56px);line-height:1.12;letter-spacing:-.025em}
.claim{color:var(--ember)}
.chevrons{display:flex;justify-content:center;will-change:transform}
.chev{--cw:clamp(170px,30vw,400px);flex:0 0 auto;margin:0 0 0 calc(var(--cw) * -.12);width:var(--cw);aspect-ratio:1/1.05;clip-path:polygon(0 0,72% 0,100% 50%,72% 100%,0 100%,28% 50%);overflow:hidden;background:var(--bone)}
.chev:first-child{margin-left:0}
.chev img{width:100%;height:100%;object-fit:cover;transform:scale(1.15)}
.chev img.contain{object-fit:contain;padding:12% 18% 12% 26%;background:var(--bone)}
@media (max-width:760px){.steps3{grid-template-columns:1fr}}
/* Produkt */
.product .shot{position:relative;padding:0;overflow:hidden;aspect-ratio:4/5;max-width:100%}
.product .shot img{width:100%;height:100%;object-fit:cover}
.product .tag{position:absolute;left:12px;top:10px;background:var(--canvas);border-radius:var(--r);padding:2px 8px}
.price{display:flex;align-items:baseline;gap:12px;margin-top:8px}
.product .actions{display:flex;gap:8px;flex-wrap:wrap}
/* Rezept */
.recipe-sec{padding-block:clamp(8px,2vw,24px) clamp(64px,8vw,96px);display:grid;gap:32px}
.recipe-wrap{display:grid;grid-template-rows:1fr;transition:grid-template-rows .9s cubic-bezier(.16,1,.3,1)}
.js .recipe-wrap:not(.open){grid-template-rows:0fr}
.recipe-clip{overflow:hidden;min-height:0}
.recipe-wrap .recipe-sec{opacity:1;transform:none;transition:opacity .6s .15s,transform .8s .1s cubic-bezier(.16,1,.3,1)}
.js .recipe-wrap:not(.open) .recipe-sec{opacity:0;transform:translateY(-24px)}
#recipeBtn .arr{display:inline-block;transition:transform .3s}
#recipeBtn[aria-expanded="true"] .arr{transform:rotate(180deg)}
.recipe{padding:0}
.rc-head{display:flex;justify-content:space-between;gap:12px;padding:12px 24px;border-bottom:var(--hair)}
.rc-body{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,56px);padding:24px}
.rc-title{font:500 19px/1.35 var(--serif);margin-bottom:12px}
.ing{list-style:none;margin:0;padding:0}
.ing li{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px dashed var(--stone);font:400 19px/1.4 var(--serif)}
@media (max-width:760px){.rc-body{grid-template-columns:1fr}}
/* Intro: ein Treberkorn faellt ins "o", der Schriftzug waechst daraus, dann oeffnet sich das Beige */
.intro{position:fixed;inset:0;z-index:80;display:grid;place-items:center;pointer-events:auto;animation:introGone 0s linear 4.2s forwards}
@keyframes introGone{to{visibility:hidden;pointer-events:none}}
.intro .panel{position:absolute;top:0;bottom:0;width:50.5%;background:var(--canvas);transition:transform 1s cubic-bezier(.77,0,.18,1)}
.intro .panel.l{left:0;animation:panelL 1s cubic-bezier(.77,0,.18,1) 3.1s forwards}
.intro .panel.r{right:0;animation:panelR 1s cubic-bezier(.77,0,.18,1) 3.1s forwards}
@keyframes panelL{to{transform:translateX(-101%)}}
@keyframes panelR{to{transform:translateX(101%)}}
.intro.done .panel.l{transform:translateX(-101%)}
.intro.done .panel.r{transform:translateX(101%)}
.intro-in{position:relative;display:grid;justify-items:center;gap:22px;transition:opacity .45s ease,transform .6s cubic-bezier(.77,0,.18,1);animation:inOut .45s ease 2.95s forwards}
@keyframes inOut{to{opacity:0;transform:scale(.97)}}
.intro.done .intro-in{opacity:0;transform:scale(.97)}
.intro .mark{position:relative;width:min(62vw,380px);aspect-ratio:720/262}
.intro .mark img{position:absolute;display:block;max-width:none}
.intro .logo-full{inset:0;width:100%;height:100%;clip-path:circle(0% at 70% 41.8%);-webkit-clip-path:circle(0% at 70% 41.8%);animation:grow 1.15s cubic-bezier(.22,.8,.2,1) 1.2s forwards}
@keyframes grow{to{clip-path:circle(80% at 70% 41.8%);-webkit-clip-path:circle(80% at 70% 41.8%)}}
.intro .grain{left:67.08%;top:29.01%;width:5.83%;height:auto;transform-origin:50% 60%;transform:translateY(-58vh) rotate(-70deg);opacity:0;animation:fall .95s cubic-bezier(.55,0,.9,.4) .25s forwards,settle .38s cubic-bezier(.3,1.6,.5,1) 1.2s forwards}
@keyframes fall{0%{opacity:0;transform:translateY(-58vh) rotate(-70deg)}12%{opacity:1}100%{opacity:1;transform:translateY(0) rotate(0)}}
