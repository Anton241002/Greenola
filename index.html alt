<script>
(() => {
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
document.documentElement.classList.add('js');
const $ = s => document.querySelector(s);
const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
const eo = t => 1 - Math.pow(1 - t, 3);
const eio = t => t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

/* Vorbestellung (Vorschau: wird noch nicht gespeichert) */
function mailForm(form, input, out){
  $(form).addEventListener('submit', e => {
    e.preventDefault();
    const v = $(input).value.trim(), msg = $(out);
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    msg.className = 'pre-msg ' + (ok ? 'ok' : 'err');
    msg.textContent = ok
      ? 'Danke! Vorschau: Die Anmeldung wird auf dieser Seite noch nicht gespeichert.'
      : 'Bitte gib eine gültige E-Mail-Adresse ein, zum Beispiel name@beispiel.ch.';
  });
}
mailForm('#preForm', '#preMail', '#preMsg');
mailForm('#checkout', '#shopMail', '#shopMsg');

/* ---------- Einstieg: Koerner werden von der Granola-Schale zur Gerstengarbe ---------- */
const hero = $('#start'), stage = $('#stage'), motif = $('#motif'), cv = $('#morph'), cx = cv.getContext('2d');
const heroSub = $('#heroSub'), pa = document.querySelector('.pa'), pb = document.querySelector('.pb'), cue = $('#cue'), header = $('#top');
const V = {s: 0, dpr: 1};
const ready = true;
function mulberry(a){ return () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
const EARS = 7, PER = 24, N = EARS * PER;
let parts = [], sheaf = [];
function build(){
  const rnd = mulberry(11);
  /* A: Schale mit Granola (Haferhaufen mit Mandeln, Cranberrys, Kernen) */
  const cxA = .5, R = .6, rw = .42, mh = .25, A = [];
  let tries = 0;
  while (A.length < N && tries < 20000){
    tries++;
    const dx = (rnd() * 2 - 1) * rw, top = R - mh * Math.pow(Math.max(0, 1 - (dx / rw) ** 2), .75);
    const y = top + rnd() * (R + .012 - top), x = cxA + dx;
    if (A.every(q => (q.x - x) ** 2 + (q.y - y) ** 2 > .027 ** 2)) A.push({x, y});
  }
  while (A.length < N){ const dx = (rnd() * 2 - 1) * rw * .8; A.push({x: cxA + dx, y: R - rnd() * mh * .6}); }
  A.sort((a, b) => a.x - b.x);
  /* B: Garbe aus Gerstenaehren */
  const B = []; sheaf = [];
  const bx = .5, by = .72;
  for (let e = 0; e < EARS; e++){
    const th = (-39 + e * 13 + (rnd() - .5) * 4) * Math.PI / 180;
    const dir = [Math.sin(th), -Math.cos(th)], nrm = [Math.cos(th), Math.sin(th)];
    const stalk = .3 + rnd() * .04 - Math.abs(th) * .06, head = .25;
    const hs = [bx + dir[0] * stalk, by + dir[1] * stalk];
    const lowTh = th * .4 + Math.PI, low = [bx + Math.sin(lowTh) * .22, by - Math.cos(lowTh) * .22];
    sheaf.push({th, top: [hs[0] + dir[0] * head, hs[1] + dir[1] * head], hs, low});
    for (let k = 0; k < PER; k++){
      const row = k >> 1, side = k & 1 ? 1 : -1, s = row / (PER / 2 - 1);
      const off = .021 * (1 - .4 * s);
      const x = hs[0] + dir[0] * head * s + nrm[0] * side * off, y = hs[1] + dir[1] * head * s + nrm[1] * side * off;
      B.push({x, y, a: th + side * .38, len: .044 * (1 - .3 * s), wid: .017 * (1 - .2 * s), ear: e, side, th});
    }
  }
  B.sort((a, b) => a.x - b.x);
  const gran = ['#B5733A', '#C4843F', '#A9682F', '#BE7E45', '#9E5F2B'];
  parts = A.map((a, i) => {
    const b = B[i], r = rnd();
    let kind = 'oat';
    if (r < .09) kind = 'almond'; else if (r < .16) kind = 'berry'; else if (r < .22) kind = 'seed';
    const aProps = kind === 'almond' ? {len: .06, wid: .031, col: '#D6B489'} :
                   kind === 'berry'  ? {len: .031, wid: .027, col: '#7E2330'} :
                   kind === 'seed'   ? {len: .048, wid: .022, col: '#6E7A3C'} :
                                       {len: .042 + rnd() * .012, wid: .019 + rnd() * .007, col: gran[(rnd() * gran.length) | 0]};
    const m = 185 + rnd() * 25 | 0;
    return {ax: a.x, ay: a.y, aa: rnd() * 6.28, ...{alen: aProps.len, awid: aProps.wid, acol: hex(aProps.col)},
            bx: b.x, by: b.y, ba: b.a, blen: b.len, bwid: b.wid, bcol: [m, m - 45 + (rnd() * 12 | 0), m - 105 + (rnd() * 14 | 0)],
            kind, d: (1 - (by - b.y) / .55) * .32 + rnd() * .06, lift: .05 + rnd() * .08, ear: b.ear, th: b.th, side: b.side};
  });
  parts.sort((p, q) => p.ay - q.ay);
}
function hex(h){ return [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)]; }
function layout(){
  V.dpr = Math.min(devicePixelRatio || 1, 2);
  V.s = motif.clientWidth;
  cv.width = cv.height = Math.round(V.s * V.dpr);
  if (!parts.length) build();
}
function kernel(x, y, a, len, wid, col, round, crease){
  cx.save(); cx.translate(x, y); cx.rotate(a);
  cx.fillStyle = `rgb(${col[0] | 0},${col[1] | 0},${col[2] | 0})`;
  cx.beginPath();
  if (round) cx.ellipse(0, 0, wid / 2, len / 2, 0, 0, 7);
  else { cx.moveTo(0, -len / 2); cx.bezierCurveTo(wid * .62, -len * .2, wid * .52, len * .32, 0, len / 2); cx.bezierCurveTo(-wid * .52, len * .32, -wid * .62, -len * .2, 0, -len / 2); }
  cx.fill(); cx.stroke();
  if (crease){ cx.beginPath(); cx.moveTo(0, -len * .28); cx.quadraticCurveTo(wid * .1, 0, 0, len * .3); cx.stroke(); }
  cx.restore();
}
const INK = 'rgba(45,48,13,';
function draw(p, now = performance.now()){
  const S = V.s, t = now / 1000, dpr = V.dpr;
  cx.setTransform(dpr, 0, 0, dpr, 0, 0); cx.clearRect(0, 0, S, S);
  const T = clamp((p - .1) / .62);                    // Verwandlung 0..1
  const sway = Math.sin(t * .9) * .012 * eo(T);
  /* Schale (verschwindet) */
  const bowlA = 1 - clamp(T / .35);
  if (bowlA > 0){
    const R = .6 * S, l = .06 * S, r = .94 * S;
    cx.globalAlpha = bowlA; cx.lineWidth = 1.3; cx.strokeStyle = INK + '.8)'; cx.fillStyle = '#EADCC4';
    cx.beginPath(); cx.moveTo(l, R); cx.bezierCurveTo(l + .03 * S, R + .36 * S, r - .03 * S, R + .36 * S, r, R); cx.closePath(); cx.fill(); cx.stroke();
    cx.beginPath(); cx.moveTo(.38 * S, R + .268 * S); cx.lineTo(.35 * S, R + .31 * S); cx.lineTo(.65 * S, R + .31 * S); cx.lineTo(.62 * S, R + .268 * S); cx.stroke();
    cx.globalAlpha = 1;
  }
  /* Garbe: Halme, Band (erscheinen) */
  const stalkA = clamp((T - .45) / .4);
  if (stalkA > 0){
    cx.globalAlpha = stalkA; cx.strokeStyle = INK + '.75)'; cx.lineWidth = 1.2; cx.lineCap = 'round';
    for (const e of sheaf){
      const sw = sway * (e.th + .6);
      cx.beginPath(); cx.moveTo(e.low[0] * S, e.low[1] * S);
      cx.quadraticCurveTo(.5 * S, .72 * S, (e.hs[0] + sw) * S, e.hs[1] * S); cx.stroke();
    }
    cx.lineWidth = 1.6;
    cx.beginPath(); cx.ellipse(.5 * S, .715 * S, .04 * S, .013 * S, 0, 0, 7); cx.stroke();
    cx.beginPath(); cx.ellipse(.5 * S, .742 * S, .034 * S, .011 * S, 0, 0, 7); cx.stroke();
    cx.globalAlpha = 1;
  }
  /* Koerner */
  cx.lineWidth = .8; cx.strokeStyle = 'rgba(60,40,15,.45)';
  const awns = [];
  for (const q of parts){
    const k = eio(clamp((T - q.d * .6) / .55));
    const sw = sway * ((q.bx - .5) * 2 + .6) * k;
    const x = (q.ax + (q.bx + sw - q.ax) * k) * S;
    const y = (q.ay + (q.by - q.ay) * k - Math.sin(k * Math.PI) * q.lift) * S;
    const a = q.aa + (q.ba - q.aa) * k;
    const col = q.acol.map((c, i) => c + (q.bcol[i] - c) * k);
    const round = q.kind === 'berry' && k < .5;
    kernel(x, y, a, (q.alen + (q.blen - q.alen) * k) * S, (q.awid + (q.bwid - q.awid) * k) * S, col, round, q.kind !== 'berry' || k > .5);
    if (k > .7) awns.push([x, y, q.th + q.side * .12, (k - .7) / .3, a]);
  }
  /* Grannen */
  cx.lineWidth = .7;
  for (const [x, y, dirA, f, ka] of awns){
    const L = .1 * S * f, sx = x + Math.sin(ka) * .02 * S, sy = y - Math.cos(ka) * .02 * S;
    cx.strokeStyle = INK + (.5 * f).toFixed(3) + ')';
    cx.beginPath(); cx.moveTo(sx, sy); cx.lineTo(sx + Math.sin(dirA) * L, sy - Math.cos(dirA) * L); cx.stroke();
  }
}
function copy(p){
  const a = eio(clamp((p - .22) / .16)), b = eio(clamp((p - .32) / .2));
  pa.style.transform = `translateY(${-a * 60}%)`; pa.style.opacity = 1 - a;
  pb.style.transform = `translateY(${(1 - b) * 60}%)`; pb.style.opacity = b;
  heroSub.style.opacity = b; heroSub.style.transform = `translateY(${(1 - b) * 12}px)`;
  cue.style.opacity = 1 - clamp(p / .1); cue.style.pointerEvents = p > .08 ? 'none' : '';
}

/* Weiche Nachfuehrung: das Bild folgt dem Scroll wie ein langsamer Zoom */
let target = 0, cur = 0, last = performance.now(), raf = 0;
/* Die Position wird in jedem Bild neu gelesen: so laeuft die Animation auch auf Handys,
   die Scroll-Ereignisse nur verzoegert oder gar nicht melden (iOS, eingebettete Ansichten). */
let hr = hero.getBoundingClientRect();
const readTarget = () => { hr = hero.getBoundingClientRect(); target = clamp(-hr.top / Math.max(1, hr.height - stage.clientHeight)); };
let drawn = -1;
function tick(now){
  const dt = Math.min(64, now - last), k = reduce ? 1 : 1 - Math.exp(-dt / 150); last = now;   // ohne Animationen: kein Nachlaufen
  readTarget(); chevs();
  header.classList.toggle('solid', hr.top < -30);
  cur += (target - cur) * k;
  if (Math.abs(target - cur) < .0003) cur = target;
  const live = !reduce && cur > .5 && hr.bottom > 0 && !document.body.classList.contains('on-sub');
  if (cur !== drawn || needDraw || live){ draw(cur, now); copy(cur); drawn = cur; needDraw = !ready; }
  raf = requestAnimationFrame(tick);
}
let needDraw = true;
const kick = () => { if (!raf){ last = performance.now(); raf = requestAnimationFrame(tick); } };
function onScroll(){ readTarget(); kick(); }
let lw = innerWidth, lh = innerHeight;
addEventListener('resize', () => {
  // Handy-Adressleiste blendet sich beim Scrollen ein und aus: nur bei echter Groessenaenderung neu aufbauen
  if (innerWidth !== lw || Math.abs(innerHeight - lh) > 140){ lw = innerWidth; lh = innerHeight; layout(); needDraw = true; }
});
document.addEventListener('visibilitychange', () => { if (!document.hidden) kick(); });

/* Pfeilbilder gleiten beim Scrollen herein */
const chev = $('#chevrons');
let lastC = -1;
function chevs(){
  const vh = innerHeight, r = chev.getBoundingClientRect(), c = clamp((vh - r.top) / (vh + r.height));
  if (Math.abs(c - lastC) < .0005) return; lastC = c;
  chev.style.transform = `translateX(${(1 - eo(c)) * 30 - 4}%)`;
  [...chev.children].forEach((ch, i) => {
    const k = clamp(c * 2.2 - i * .2);
    ch.style.opacity = .25 + k * .75;
    ch.firstElementChild.style.transform = `scale(${1.15 - k * .1}) translateX(${(1 - k) * 12}%)`;
  });
}
chevs();

layout(); copy(0); onScroll(); kick();
/* Unterseiten (Biertreber, Shop) als Ansichten in derselben Datei.
   Interne Links wechseln nur die Ansicht und scrollen, ohne die Adresse zu aendern:
   so meldet keine Vorschau "externe Seite", und alles bleibt in einer HTML. */
const views = {biertreber: $('#biertreber'), shop: $('#shop')};
let view = null;
function showView(name){
  view = name;
  Object.entries(views).forEach(([k, el]) => { el.hidden = k !== name; });
  document.body.classList.toggle('on-sub', !!name);
  if (name) views[name].querySelectorAll('.fade').forEach(e => e.classList.add('in'));
  lastC = -1; needDraw = true;
}
function go(id, smooth){
  if (views[id]){ showView(id); scrollTo(0, 0); return; }
  const was = view; showView(null);
  if (id === 'rezept') setRecipe(true, false);
  const el = id && id !== 'start' ? document.getElementById(id) : null;
  const top = el ? el.getBoundingClientRect().top + scrollY - 80 : 0;
  scrollTo({top, behavior: smooth && !was && !reduce ? 'smooth' : 'auto'});
}
document.addEventListener('click', e => {
  const a = e.target.closest('a[href^="#"]'); if (!a) return;
  e.preventDefault();
  go(a.getAttribute('href').slice(1), true);
});

/* Rezept klappt unter dem Produkt auf */
const recipe = $('#rezept'), recipeBtn = $('#recipeBtn');
function setRecipe(open, scroll){
  recipe.classList.toggle('open', open);
  recipeBtn.setAttribute('aria-expanded', open);
  recipeBtn.firstChild.nodeValue = open ? 'Rezept schliessen ' : 'Rezept ansehen ';
  if (open && scroll) setTimeout(() => recipe.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block: 'start'}), 120);
}
recipeBtn.addEventListener('click', () => setRecipe(!recipe.classList.contains('open'), true));
/* Direkt-Link wie ...#shop oder ...#biertreber beim Oeffnen */
try { const h = location.hash.slice(1); if (h) go(h, false); } catch (err) {}

/* ---------- Shop: Menge, Lieferung, Kasse ---------- */
const PRICE = 9;
let qty = 1;
const qVal = $('#qVal'), qMinus = $('#qMinus'), tSum = $('#tSum'), tNote = $('#tNote');
function updShop(){
  qVal.textContent = qty; qMinus.disabled = qty <= 1;
  tSum.textContent = 'CHF ' + (qty * PRICE).toFixed(2);
  const post = document.querySelector('input[name="ship"]:checked').value === 'post';
  tNote.textContent = post ? '+ Porto' : '';
}
qMinus.addEventListener('click', () => { qty = Math.max(1, qty - 1); updShop(); });
$('#qPlus').addEventListener('click', () => { qty = Math.min(20, qty + 1); updShop(); });
document.querySelectorAll('input[name="ship"]').forEach(r => r.addEventListener('change', updShop));
$('#toCheckout').addEventListener('click', () => { const c = $('#checkout'); c.hidden = false; $('#shopMail').focus(); });
updShop();

const intro = $('#intro'), ibar = $('#introBar'), t0 = performance.now();
let got = 0; const step = i => (ibar.style.transform = `scaleX(${++got / 2})`, i);
const openPage = () => { if (!intro.isConnected || intro.classList.contains('done')) return; intro.classList.add('done'); setTimeout(() => intro.remove(), 1100); };
setTimeout(openPage, 6000);
setTimeout(openPage, reduce ? 0 : 3050);
got = 2; ibar.style.transform = 'scaleX(1)';
readTarget(); cur = target; needDraw = true;
})();
</script>
